# Copy this file to .env and fill in what applies. Every value here also has a
# sensible built-in default in app/config.py — you only need to override what
# you want to change.

# --- Channel ---
CHANNEL_NAME=Yagmurun Oyun Bahcesi
CHANNEL_HASHTAGS=#YagmurunOyunBahcesi #Shorts #cocuk #aile

# --- Google Drive ---
# Folder ID is the long string in the Drive folder's URL:
# https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=
DRIVE_POLL_INTERVAL_SECONDS=300
GOOGLE_OAUTH_CLIENT_SECRET_FILE=secrets/google_oauth_client_secret.json
GOOGLE_TOKEN_FILE=secrets/google_token.json

# --- YouTube ---
YOUTUBE_CATEGORY_ID=24
YOUTUBE_PRIVACY_STATUS=public
MADE_FOR_KIDS_DEFAULT=true

# --- Whisper (speech-to-text, free/local default) ---
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=tr
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- ElevenLabs Scribe (optional, paid — only if you have your own subscription) ---
# If set, transcription (and therefore captions) uses this instead of local
# Whisper. Get a key at https://elevenlabs.io -> Profile -> API Keys. Falls
# back to Whisper automatically if the call fails, so a bad/expired key never
# blocks a video.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# --- Music (optional) ---
# Only needed if you want scripts/fetch_pixabay_music.py to help populate
# music_library/ automatically. Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Web UI ---
# For local-only access, leave as 127.0.0.1. For remote access from your
# phone via Tailscale, set this to your PC's Tailscale IP (`tailscale ip -4`)
# — never 0.0.0.0, that would also expose it to your whole home WiFi.
WEB_HOST=127.0.0.1
WEB_PORT=8765
# Required whenever WEB_HOST is anything other than 127.0.0.1 — the app can
# approve YouTube uploads and shows private video, so it must never sit open
# without a login once more than just this PC can reach it.
WEB_AUTH_USERNAME=yagmur
WEB_AUTH_PASSWORD=

# --- Push notifications (optional) ---
# Free, no account needed: https://ntfy.sh. Pick a random, hard-to-guess
# topic name (treat it like a password — anyone who knows it can read your
# notifications) and subscribe to the same topic in the ntfy phone app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Local LLM (optional, powers the /chat page) ---
# Free, runs entirely on this PC via Ollama (https://ollama.com) — no API key,
# no internet needed after the model is pulled once. If Ollama isn't running,
# /chat falls back to the plain rule-based instruction parser.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
